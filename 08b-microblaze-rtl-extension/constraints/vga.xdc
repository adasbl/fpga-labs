# Nexys A7-100T VGA connector.
set_property PACKAGE_PIN A3  [get_ports {red_o[0]}]
set_property PACKAGE_PIN B4  [get_ports {red_o[1]}]
set_property PACKAGE_PIN C5  [get_ports {red_o[2]}]
set_property PACKAGE_PIN A4  [get_ports {red_o[3]}]
set_property PACKAGE_PIN C6  [get_ports {green_o[0]}]
set_property PACKAGE_PIN A5  [get_ports {green_o[1]}]
set_property PACKAGE_PIN B6  [get_ports {green_o[2]}]
set_property PACKAGE_PIN A6  [get_ports {green_o[3]}]
set_property PACKAGE_PIN B7  [get_ports {blue_o[0]}]
set_property PACKAGE_PIN C7  [get_ports {blue_o[1]}]
set_property PACKAGE_PIN D7  [get_ports {blue_o[2]}]
set_property PACKAGE_PIN D8  [get_ports {blue_o[3]}]
set_property PACKAGE_PIN B11 [get_ports {hsync_o}]
set_property PACKAGE_PIN B12 [get_ports {vsync_o}]
